{
  "backend": "codex",
  "tasks_file": "orchestrator/TASKS.md",
  "progress_file": "orchestrator/PROGRESS.md",
  "branch": "auto/tasks",
  "remote": "origin",
  "push": true,
  "codex_bin": "codex",
  "opencode_bin": "opencode",
  "sandbox": "workspace-write",
  "gate_base": [],
  "task_timeout": 3600,
  "gate_timeout": 1800,
  "git_timeout": 120,
  "restart_retries": 3,
  "retry_delay": 30,
  "models": {
    "codex": {
      "light": "gpt-5.6-luna",
      "standard": "gpt-6.1-sol",
      "heavy": "gpt-6-astra"
    },
    "opencode": {
      "light": "opencode/glm-5.3-flash-free",
      "standard": "opencode/glm-5.3-flash-free#max",
      "heavy": "opencode/beam-free#max"
    }
  },
  "model_sets": {
    "opencode": {
      "paid": {
        "light": "provider/light-model",
        "standard": "provider/standard-model",
        "heavy": "provider/heavy-model"
      }
    }
  },
  "efforts": {
    "light": "low",
    "standard": "medium",
    "heavy": "high"
  },
  "checks": {
    "full": [
      "python3 -m unittest discover -s orchestrator/tests",
      "make test"
    ],
    "lint": [
      "make lint"
    ]
  }
}
