{
  "tasks_file": "orchestrator/TASKS.md",
  "progress_file": "orchestrator/PROGRESS.md",
  "branch": "auto/tasks",
  "remote": "origin",
  "push": true,
  "backend": "codex",
  "codex_bin": "codex",
  "opencode_bin": "opencode",
  "sandbox": "workspace-write",
  "gate_base": [],
  "checks": {
    "full": [
      "python3 -m unittest discover -s orchestrator/tests",
      "bash ./gradlew testDebugUnitTest lintDebug --console=plain"
    ],
    "android": [
      "bash ./gradlew :app:compileDebugKotlin :app:lintDebug --console=plain"
    ]
  },
  "task_timeout": 3600,
  "gate_timeout": 3600,
  "git_timeout": 120,
  "restart_retries": 3,
  "retry_delay": 30,
  "models": {
    "codex": {
      "light": "gpt-5.6-luna",
      "standard": "gpt-6.1-sol",
      "heavy": "gpt-6.1-sol"
    },
    "opencode": {
      "light": "opencode/glm-5.3-flash-free",
      "standard": "opencode/glm-5.3-flash-free#max",
      "heavy": "opencode/beam-free#max"
    }
  },
  "efforts": {
    "light": "low",
    "standard": "medium",
    "heavy": "high"
  }
}
