<?xml version="1.0" encoding="utf-8"?>
<!--
   Explicit backup rules for legacy Android (API 23-30).
   Exclude all databases, SharedPreferences, and private files to preserve 100% Offline & Private compliance.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
</full-backup-content>
