<?xml version="1.0" encoding="utf-8"?>
<!--
   Explicitly exclude all databases, SharedPreferences, and private files
   from Cloud Backup and Device Transfers to ensure 100% Offline & Private compliance.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
